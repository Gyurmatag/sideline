# Copy to .dev.vars (gitignored) and fill in real values for local dev.
# In production set these as Cloudflare Worker secrets: `wrangler secret put <NAME>`.

# --- LLM providers (used by agents + the multi-tier eval system, via the Vercel AI SDK) ---
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- SpacetimeDB (public, client-safe; have sensible defaults in code) ---
NEXT_PUBLIC_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB=sideline-dev

# --- Agent service identity (SpacetimeDB token for agents/CI; server-side only) ---
SPACETIMEDB_TOKEN=

# --- Better Auth (organizer email/password sign-in, backed by Cloudflare D1) ---
# Generate the secret with: openssl rand -hex 32
# In production set BETTER_AUTH_SECRET as a Worker secret; BETTER_AUTH_URL is a var
# in apps/web/wrangler.jsonc. The D1 binding (AUTH_DB) is configured there too.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
